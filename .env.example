# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored - never commit real credentials. docker compose reads it automatically.

# --- Database (docker-compose.yml) -------------------------------------------
# The SA password for the local SQL Server container. The api container builds its connection
# string from this, reaching SQL Server by its service name ("sqlserver").
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- API container (docker-compose.yml) ----------------------------------------
# Key that signs the API's access tokens (HS256, at least 32 bytes). Required: without it the api
# container stops at start-up with a message naming this setting - nothing in the image provides one.
# This placeholder is fine on your own machine; anywhere else generate a real one:
#   openssl rand -base64 48      (PowerShell: [Convert]::ToBase64String([byte[]](1..48 | % { Get-Random -Max 256 })))
Jwt__SigningKey=replace-with-a-random-key-of-at-least-32-bytes

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- API run with `npm run api` (outside Docker) ---------------------------------
# `dotnet run` does not read this file; it uses appsettings.Development.json, which already has
# working local values. To override something, set it in your shell first, for example:
#   ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False
#   Jwt__TokenLifetimeMinutes=60

# --- Web app ----------------------------------------------------------------------------
# Point the Vite dev server's /api proxy at the container instead of `npm run api`:
#   VITE_API_PROXY_TARGET=http://localhost:5080
