# JWT configuration for local development.
# Generate a unique random key; never commit the real value.
Jwt__Key=REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_32_BYTES
Jwt__Issuer=NorthwindSupportDesk
Jwt__Audience=NorthwindSupportDesk
Jwt__LifetimeMinutes=60

# Vite frontend API endpoint (optional if using the development proxy).
VITE_API_BASE_URL=https://localhost:7043/api
